{%- if section.blocks.size > 0 -%}
<section class="sec theme-light reviews" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 
        <b>{{ section.settings.rating }}</b> {{ section.settings.rating_text }}
      </span>
      <span class="agg">{{ section.settings.social_proof }}</span>
    </div>
  </div>
  
  <div class="revrail rv" aria-label="Customer reviews">
      <div class="revtrack">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- assign review = block.settings.review_metaobject -%}
            <article class="rcard" {{ block.shopify_attributes }}>
              <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              
              {%- if review -%}
                <h5>{{ review.title | escape }}</h5>
                <p>{{ review.text | escape }}</p>
                <div class="who">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  <b>{{ review.author | escape }}</b>
                  {%- if review.product_tag != blank -%}
                    <span>&middot; {{ review.product_tag | escape }}</span>
                  {%- endif -%}
                </div>
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <h5>Best cleaner I've used</h5>
                    <p>The multi-surface cleaner easily tackles kitchen grease and leaves no chemical smell behind. Absolutely love the subtle citrus scent.</p>
                    <div class="who">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                      <b>Priya S.</b>
                      <span>&middot; Multi-Surface</span>
                    </div>
                  {%- when 2 -%}
                    <h5>Safe for my toddler</h5>
                    <p>Finally a floor cleaner I don't have to worry about when my toddler is crawling around. Cleans beautifully without the harsh toxins.</p>
                    <div class="who">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                      <b>Neha K.</b>
                      <span>&middot; Floor Cleaner</span>
                    </div>
                  {%- when 3 -%}
                    <h5>Sparkling clean!</h5>
                    <p>I was skeptical about plant-based cleaners for the bathroom, but this works better than bleach and smells incredible.</p>
                    <div class="who">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                      <b>Aarti M.</b>
                      <span>&middot; Bathroom Core</span>
                    </div>
                  {%- when 4 -%}
                    <h5>Grease literally melts away</h5>
                    <p>The kitchen degreaser is magic. Just spray, wipe, and the stove is spotless. I've already bought the refill pack.</p>
                    <div class="who">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                      <b>Rahul V.</b>
                      <span>&middot; Kitchen Combo</span>
                    </div>
                  {%- else -%}
                    <h5>Highly recommend the bundle</h5>
                    <p>Buying the Whole Home bundle was the best decision. Every product is fantastic and the microfibre cloths are super high quality.</p>
                    <div class="who">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                      <b>Sneha T.</b>
                      <span>&middot; Whole Home</span>
                    </div>
                {%- endcase -%}
              {%- endif -%}
            </article>
          {%- endfor -%}
        {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .revband {
    padding: var(--sec-y) 0;
  }
  #shopify-section-{{ section.id }} .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }
  #shopify-section-{{ section.id }} .revhead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .revhead .kicker {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-sub);
  }
  #shopify-section-{{ section.id }} .revhead .agg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-sub);
  }
  #shopify-section-{{ section.id }} .revhead .agg b {
    color: var(--text-main);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .revhead .st {
    color: var(--text-main);
    font-size: 14px;
    letter-spacing: 0.1em;
  }
  
  #shopify-section-{{ section.id }} .revrail {
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  #shopify-section-{{ section.id }} .revtrack {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marq 60s linear infinite;
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .revrail:hover .revtrack,
  #shopify-section-{{ section.id }} .revrail:focus-within .revtrack {
    animation-play-state: paused;
  }
  @keyframes marq {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  
  #shopify-section-{{ section.id }} .rcard {
    flex: 0 0 auto;
    width: 380px;
    padding: 32px;
    border-radius: var(--r);
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    transition: background 0.3s ease;
  }
  #shopify-section-{{ section.id }} .rcard:hover {
    background: var(--card-hover);
  }
  #shopify-section-{{ section.id }} .rcard .st {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: -0.05em;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .rcard h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ section.id }} .rcard p {
    font-size: 16px;
    color: var(--text-sub);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .rcard .who {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-sub);
  }
  #shopify-section-{{ section.id }} .rcard .who b {
    color: var(--text-main);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .rcard .who svg {
    width: 14px;
    height: 14px;
    color: var(--text-main);
    flex: 0 0 auto;
  }
  
  @media(max-width: 760px) {
    #shopify-section-{{ section.id }} .rcard {
      width: 300px;
      padding: 24px;
    }
    #shopify-section-{{ section.id }} .revtrack {
      animation-duration: 40s;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "html",
      "id": "social_proof",
      "label": "Social Proof Text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review_reference",
      "name": "Review",
      "settings": [
        {
          "type": "metaobject",
          "id": "review_metaobject",
          "label": "Review Metaobject",
          "metaobject_type": "purelane_review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        }
      ]
    }
  ]
}
{% endschema %}
