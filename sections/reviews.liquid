<section class="sec revband" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 
        <b>{{ section.settings.rating }}</b> {{ section.settings.rating_text }}
      </span>
      <span class="agg">{{ section.settings.social_proof }}</span>
    </div>
  </div>
  
  {%- if section.blocks.size > 0 -%}
    <div class="revrail rv" aria-label="Customer reviews">
      <div class="revtrack">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- assign review = block.settings.review_metaobject -%}
            <article class="glass-2 rcard" {{ block.shopify_attributes }}>
              <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <h5>{{ review.title | default: 'Example review title' | escape }}</h5>
              <p>{{ review.text | default: 'This is a placeholder review text to show how it will look. Link a real review metaobject in the block settings.' | escape }}</p>
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ review.author | default: 'Verified Buyer' | escape }}</b>
                {%- if review.product_tag != blank or request.design_mode -%}
                  <span>&middot; {{ review.product_tag | default: 'Example product' | escape }}</span>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% style %}
  #shopify-section-{{ section.id }} .revband {
    padding: var(--sec-y) 0;
  }
  #shopify-section-{{ section.id }} .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }
  #shopify-section-{{ section.id }} .revhead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px 18px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  #shopify-section-{{ section.id }} .revhead .kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  #shopify-section-{{ section.id }} .revhead .agg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--paper-2);
  }
  #shopify-section-{{ section.id }} .revhead .agg b {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    color: var(--accent);
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .revhead .st {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: .16em;
  }
  
  #shopify-section-{{ section.id }} .revrail {
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  #shopify-section-{{ section.id }} .revtrack {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marq 52s linear infinite;
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .revrail:hover .revtrack,
  #shopify-section-{{ section.id }} .revrail:focus-within .revtrack {
    animation-play-state: paused;
  }
  @keyframes marq {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  
  #shopify-section-{{ section.id }} .rcard {
    flex: 0 0 auto;
    width: 320px;
    padding: 18px 20px;
    border-radius: 18px;
  }
  #shopify-section-{{ section.id }} .rcard .st {
    color: var(--accent);
    font-size: 10.5px;
    letter-spacing: .2em;
    margin-bottom: 9px;
  }
  #shopify-section-{{ section.id }} .rcard h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--surface);
    margin-bottom: 7px;
  }
  #shopify-section-{{ section.id }} .rcard p {
    font-size: 12.6px;
    color: var(--paper-2);
    line-height: 1.52;
    margin-bottom: 11px;
  }
  #shopify-section-{{ section.id }} .rcard .who {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--paper-3);
  }
  #shopify-section-{{ section.id }} .rcard .who b {
    color: var(--surface);
    font-weight: 700;
  }
  #shopify-section-{{ section.id }} .rcard .who svg {
    width: 12px;
    height: 12px;
    color: var(--accent);
    flex: 0 0 auto;
  }
  
  @media(max-width: 760px) {
    #shopify-section-{{ section.id }} .rcard {
      width: 250px;
      padding: 13px 14px;
    }
    #shopify-section-{{ section.id }} .revtrack {
      animation-duration: 40s;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "html",
      "id": "social_proof",
      "label": "Social Proof Text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review_reference",
      "name": "Review",
      "settings": [
        {
          "type": "metaobject",
          "id": "review_metaobject",
          "label": "Review Metaobject",
          "metaobject_type": "purelane_review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        },
        {
          "type": "review_reference"
        }
      ]
    }
  ]
}
{% endschema %}
