{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign featured_match = section.settings.featured_badge_match | downcase
  assign button_url = section.settings.button_link
  if button_url == blank
    assign button_url = '#bundles'
  endif
-%}

<section
  class="sec purelane-combos"
  id="combos"
  aria-labelledby="combos-heading-{{ section.id }}"
>
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="d2" id="combos-heading-{{ section.id }}" style="margin-top:12px">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      {%- if section.settings.lede != blank -%}
        <div class="lede rte" style="margin:14px auto 0">{{ section.settings.lede }}</div>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div
        class="comborail rv"
        id="comborail-{{ section.id }}"
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.rail_aria_label | default: 'Best selling combos' | escape }}"
      >
        {%- for product in collection.products limit: products_to_show -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign price = variant.price
            assign compare_at = variant.compare_at_price
            assign savings = 0
            if compare_at != blank and compare_at > price
              assign savings = compare_at | minus: price
            endif

            assign components = product.metafields.custom.combo_components.value
            assign labels = product.metafields.custom.combo_component_labels.value
            assign badge_label = product.metafields.custom.badge_label.value
            assign component_count = 0
            if components != blank
              assign component_count = components.size
            endif

            assign is_featured = product.metafields.custom.is_featured_combo.value | default: false

            assign card_class = 'glass combo'
            if is_featured
              assign card_class = card_class | append: ' hero-combo'
            endif

            assign btn_class = 'btn btn-ghost'
            if is_featured
              assign btn_class = 'btn btn-primary'
            endif

            assign image_loading = 'lazy'
            if forloop.index <= 2
              assign image_loading = 'eager'
            endif
          -%}

          <article class="{{ card_class }}">
            <div class="tray">
              {%- if savings > 0 -%}
                <span class="save">
                  {{- section.settings.save_prefix | default: 'You save' | escape }}
                  {{ savings | money_without_trailing_zeros -}}
                </span>
              {%- endif -%}

              {%- if badge_label != blank -%}
                <span class="flag">{{ badge_label | escape }}</span>
              {%- endif -%}

              {% render 'combo-component-stack', components: components, labels: labels, loading: image_loading %}
            </div>

            <div class="body">
              <h3>{{ product.title | escape }}</h3>

              {%- if component_count > 0 -%}
                <div class="cnt">
                  {{ component_count }}
                  {{ section.settings.products_count_suffix | default: 'products' | escape }}
                </div>
              {%- endif -%}

              {%- if product.description != blank -%}
                <p class="inc">{{ product.description | strip_html | truncate: 220 }}</p>
              {%- endif -%}

              <div class="prow">
                <strong>{{ price | money_without_trailing_zeros }}</strong>
                {%- if compare_at != blank and compare_at > price -%}
                  <s>{{ compare_at | money_without_trailing_zeros }}</s>
                {%- endif -%}
                {%- if savings > 0 -%}
                  <em>
                    {{- section.settings.save_em_prefix | default: 'Save' | escape }}
                    {{ savings | money_without_trailing_zeros -}}
                  </em>
                {%- endif -%}
              </div>

              {%- if section.settings.fine_print != blank -%}
                <div class="fine">{{ section.settings.fine_print | escape }}</div>
              {%- endif -%}

              <a class="{{ btn_class }}" href="{{ button_url }}">
                {{ section.settings.button_label | default: 'Shop bundle' | escape }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13m-5-6 6 6-6 6"/>
                </svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.swipe_cue != blank -%}
        <div class="swipecue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13m-5-6 6 6-6 6"/>
          </svg>
          {{ section.settings.swipe_cue | escape }}
        </div>
      {%- endif -%}

      {%- if section.settings.rail_note != blank -%}
        <div class="railnote rte">{{ section.settings.rail_note }}</div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="railnote">Select a combos collection in section settings.</p>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .comborail {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    margin: 0 -18px;
    padding: 4px 18px 14px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .comborail::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .comborail:focus-visible {
    outline: 2px solid var(--accent, #f0a03c);
    outline-offset: 3px;
    border-radius: 6px;
  }

  #shopify-section-{{ section.id }} .combo {
    flex: 0 0 302px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 0;
    transition: 0.4s var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1));
  }

  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .combo:hover {
      transform: translateY(-5px);
    }
  }

  #shopify-section-{{ section.id }} .combo.hero-combo {
    border-color: rgba(240, 160, 60, 0.42);
    box-shadow:
      0 26px 74px rgba(18, 12, 34, 0.44),
      0 0 0 1px rgba(240, 160, 60, 0.2),
      var(--g-inset, inset 0 1px 0 rgba(255, 255, 255, 0.24));
  }

  #shopify-section-{{ section.id }} .combo .tray {
    padding: 14px 14px 13px;
    border-bottom: 1px solid rgba(236, 230, 247, 0.13);
    position: relative;
    background: linear-gradient(162deg, rgba(236, 230, 247, 0.13), rgba(75, 58, 143, 0.1));
  }

  #shopify-section-{{ section.id }} .combo .save {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(3, 30, 28, 0.72);
    border: 1px solid rgba(240, 160, 60, 0.34);
    color: var(--accent, #f0a03c);
    margin-bottom: 13px;
  }

  #shopify-section-{{ section.id }} .combo .flag {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 8.6px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent-2, #c9761d), #5d8d1c);
    color: #08211a;
  }

  #shopify-section-{{ section.id }} .stack {
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .stack .it {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .stack .it .combo-stack__img {
    height: 66px;
    width: auto;
    margin: 0 auto 8px;
    object-fit: contain;
    filter: drop-shadow(0 8px 13px rgba(1, 24, 22, 0.5));
  }

  #shopify-section-{{ section.id }} .stack .it .tile {
    height: 66px;
    width: 44px;
    margin: 0 auto 8px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: rgba(236, 230, 247, 0.08);
    border: 1px dashed rgba(236, 230, 247, 0.26);
    color: var(--accent, #f0a03c);
  }

  #shopify-section-{{ section.id }} .stack .it .tile svg {
    width: 17px;
    height: 17px;
  }

  #shopify-section-{{ section.id }} .stack .it span {
    display: block;
    font-size: 8.6px;
    line-height: 1.32;
    color: var(--paper-2, rgba(236, 230, 247, 0.74));
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .stack .plus {
    flex: 0 0 9px;
    color: var(--accent, #f0a03c);
    font-weight: 800;
    font-size: 12px;
    padding-bottom: 30px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .combo .body {
    padding: 15px 16px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .combo .body h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    line-height: 1.1;
    color: var(--surface, #faf7fd);
  }

  #shopify-section-{{ section.id }} .combo .cnt {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-3, rgba(236, 230, 247, 0.52));
    margin-top: 6px;
  }

  #shopify-section-{{ section.id }} .combo .inc {
    font-size: 12.4px;
    color: var(--paper-2, rgba(236, 230, 247, 0.74));
    line-height: 1.55;
    margin: 11px 0 14px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .combo .prow {
    display: flex;
    align-items: baseline;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .combo .prow strong {
    font-family: 'Outfit', sans-serif;
    font-size: 25px;
    font-weight: 800;
    color: var(--surface, #faf7fd);
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .combo .prow s {
    font-size: 13px;
    color: var(--paper-3, rgba(236, 230, 247, 0.52));
  }

  #shopify-section-{{ section.id }} .combo .prow em {
    font-style: normal;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(240, 160, 60, 0.18);
    border: 1px solid rgba(240, 160, 60, 0.36);
    color: var(--accent, #f0a03c);
  }

  #shopify-section-{{ section.id }} .combo .fine {
    font-size: 10.4px;
    color: var(--paper-3, rgba(236, 230, 247, 0.52));
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .combo .btn {
    width: 100%;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .railnote {
    text-align: center;
    font-size: 12px;
    color: var(--paper-3, rgba(236, 230, 247, 0.52));
    margin-top: 14px;
    max-width: 62ch;
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .swipecue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-3, rgba(236, 230, 247, 0.52));
    margin-top: 2px;
  }

  #shopify-section-{{ section.id }} .swipecue svg {
    width: 14px;
    height: 14px;
    color: var(--accent, #f0a03c);
  }

  @media (max-width: 760px) {
    #shopify-section-{{ section.id }} .combo {
      flex: 0 0 268px;
    }

    #shopify-section-{{ section.id }} .stack .it .combo-stack__img {
      height: 56px;
    }

    #shopify-section-{{ section.id }} .stack .it .tile {
      height: 56px;
      width: 38px;
    }

    #shopify-section-{{ section.id }} .comborail {
      margin: 0 -14px;
      padding: 4px 14px 12px;
    }
  }
{%- endstyle -%}

<script>
  (function () {
    var rail = document.getElementById('comborail-{{ section.id }}');
    if (!rail) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    rail.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;

      var step = event.key === 'ArrowRight' ? 280 : -280;
      rail.scrollBy({
        left: step,
        behavior: reducedMotion ? 'auto' : 'smooth'
      });
      event.preventDefault();
    });
  })();
</script>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Description",
      "default": "<p>Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Combos collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "save_prefix",
      "label": "Save prefix",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "save_em_prefix",
      "label": "Price row save prefix",
      "default": "Save"
    },
    {
      "type": "text",
      "id": "products_count_suffix",
      "label": "Product count suffix",
      "default": "products"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Inclusive of all taxes · COD available"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to #bundles when blank"
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Swipe cue",
      "default": "Swipe for more combos"
    },
    {
      "type": "richtext",
      "id": "rail_note",
      "label": "Rail note",
      "default": "<p>Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>"
    },
    {
      "type": "text",
      "id": "rail_aria_label",
      "label": "Rail aria label",
      "default": "Best selling combos"
    }
  ],
  "presets": [
    {
      "name": "Purelane combos"
    }
  ]
}
{% endschema %}
