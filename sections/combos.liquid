<section class="sec combos" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="intro">
      <span class="kicker rv">{{ section.settings.kicker }}</span>
      <h2 class="d2 rv rv-d1">{{ section.settings.heading }}</h2>
      <div class="rv rv-d2">{{ section.settings.lede }}</div>
    </div>
    
    <div class="stage">
      <div class="track">
        {%- assign collection = section.settings.collection -%}
        {%- assign products_to_show = section.settings.products_to_show -%}
        
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: products_to_show -%}
            {%- liquid
              assign variant = product.selected_or_first_available_variant
              assign price = variant.price
              assign compare_at = variant.compare_at_price
              assign savings = 0
              if compare_at > price
                assign savings = compare_at | minus: price
              endif
              
              assign card_class = 'combo glass'
              assign btn_class = 'btn btn-ghost'
              if forloop.index == 2
                assign card_class = card_class | append: ' hero-combo'
                assign btn_class = 'btn btn-primary'
              endif
            -%}
            <article class="{{ card_class }}" {{ block.shopify_attributes }}>
              <div class="tray">
                {%- if savings > 0 -%}
                  <span class="save">
                    {{- section.settings.save_prefix | default: 'You save' | escape }}
                    {{ savings | money_without_trailing_zeros -}}
                  </span>
                {%- endif -%}
                {%- if forloop.index == 2 -%}
                  <span class="flag">Best value</span>
                {%- endif -%}
                
                <div class="stack" style="margin-top: 14px">
                  <div class="it">
                    <div class="tile pimg p-floor"></div>
                    <span class="lbl">Floor Cleaner</span>
                  </div>
                  <div class="it">
                    <div class="tile pimg p-kitchen"></div>
                    <span class="lbl">Kitchen Cleaner</span>
                  </div>
                  <div class="it">
                    <div class="tile">+</div>
                    <span class="lbl">Free Cloth</span>
                  </div>
                </div>
              </div>
              
              <div class="body">
                <h4 class="d3">{{ product.title | escape }}</h4>
                
                <div class="pr">
                  <strong>{{ price | money_without_trailing_zeros }}</strong>
                  {%- if compare_at > price -%}
                    <s>{{ compare_at | money_without_trailing_zeros }}</s>
                  {%- endif -%}
                  {%- if savings > 0 -%}
                    <em>{{ section.settings.save_em_prefix | default: 'Save' | escape }} {{ savings | money_without_trailing_zeros }}</em>
                  {%- endif -%}
                </div>
                
                <div class="meta">
                  <span>3 {{ section.settings.products_count_suffix | escape }}</span>
                  <span>{{ section.settings.fine_print | escape }}</span>
                </div>
                
                <a href="{{ product.url }}" class="{{ btn_class }}">{{ section.settings.button_label | escape }}</a>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..products_to_show) -%}
            {%- liquid
              assign card_class = 'combo glass'
              assign btn_class = 'btn btn-ghost'
              if forloop.index == 2
                assign card_class = card_class | append: ' hero-combo'
                assign btn_class = 'btn btn-primary'
              endif
            -%}
            <article class="{{ card_class }}">
              <div class="tray">
                <span class="save">
                  {{- section.settings.save_prefix | default: 'You save' | escape }} ₹250
                </span>
                {%- if i == 2 -%}
                  <span class="flag">Most popular</span>
                {%- endif -%}
                
                <div class="stack" style="margin-top: 14px">
                  <div class="it">
                    <div class="tile pimg p-kitchen"></div>
                    <span class="lbl">Kitchen</span>
                  </div>
                  <div class="it">
                    <div class="tile pimg p-floor"></div>
                    <span class="lbl">Floor</span>
                  </div>
                  <div class="it">
                    <div class="tile">+</div>
                    <span class="lbl">Microfibre</span>
                  </div>
                </div>
              </div>
              
              <div class="body">
                <h4 class="d3">Kitchen & Floor Combo {{ i }}</h4>
                
                <div class="pr">
                  <strong>₹899</strong>
                  <s>₹1,149</s>
                  <em>{{ section.settings.save_em_prefix | default: 'Save' | escape }} ₹250</em>
                </div>
                
                <div class="meta">
                  <span>3 {{ section.settings.products_count_suffix | escape }}</span>
                  <span>{{ section.settings.fine_print | escape }}</span>
                </div>
                
                <a href="#" class="{{ btn_class }}">{{ section.settings.button_label | escape }}</a>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    
    <div class="cue">{{ section.settings.swipe_cue | escape }}</div>
    
    <div class="note rv">
      {{ section.settings.rail_note }}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .combos {
    padding: var(--sec-y) 0;
  }
  #shopify-section-{{ section.id }} .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  
  #shopify-section-{{ section.id }} .intro {
    max-width: 580px;
    margin-bottom: 56px;
    padding: 0 18px;
  }
  #shopify-section-{{ section.id }} .kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} h2 {
    margin-bottom: 14px;
  }
  
  #shopify-section-{{ section.id }} .stage {
    padding-bottom: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .stage::-webkit-scrollbar { display: none; }
  
  #shopify-section-{{ section.id }} .track {
    display: flex;
    gap: 16px;
    width: max-content;
    padding: 0 18px;
  }
  
  #shopify-section-{{ section.id }} .combo {
    width: min(85vw, 360px);
    scroll-snap-align: center;
    border-radius: var(--r);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .combo.hero-combo {
    background: linear-gradient(162deg, rgba(236,230,247,.13), rgba(75,58,143,.10));
  }
  
  #shopify-section-{{ section.id }} .tray {
    padding: 24px;
    border-bottom: 1px solid var(--g-line);
    position: relative;
    background: linear-gradient(180deg, rgba(236,230,247,.05), transparent);
  }
  
  #shopify-section-{{ section.id }} .save {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(240,160,60,.18);
    border: 1px solid rgba(240,160,60,.4);
    color: var(--accent);
  }

  #shopify-section-{{ section.id }} .flag {
    display: inline-block;
    margin-left: 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--surface);
    background: rgba(236,230,247,.16);
    padding: 5px 10px;
    border-radius: 999px;
  }
  
  #shopify-section-{{ section.id }} .stack {
    display: flex;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .it {
    flex: 1;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .it .tile {
    height: 72px;
    border-radius: 12px;
    background: rgba(236,230,247,.07);
    border: 1px solid var(--g-line);
    margin-bottom: 8px;
    display: grid;
    place-items: center;
    font-size: 24px;
    color: var(--paper-3);
  }
  #shopify-section-{{ section.id }} .it .pimg {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(0.65);
  }
  #shopify-section-{{ section.id }} .it .lbl {
    display: block;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--paper-2);
  }
  
  #shopify-section-{{ section.id }} .body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .body h4 {
    margin-bottom: 12px;
  }
  
  #shopify-section-{{ section.id }} .pr {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .pr strong {
    font-family: 'Outfit', sans-serif;
    font-size: 22px;
    color: var(--surface);
    font-weight: 800;
  }
  #shopify-section-{{ section.id }} .pr s {
    font-size: 14px;
    color: var(--paper-3);
  }
  #shopify-section-{{ section.id }} .pr em {
    margin-left: auto;
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    font-style: normal;
    letter-spacing: .08em;
  }
  
  #shopify-section-{{ section.id }} .meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--paper-3);
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--g-line);
    margin-top: auto;
  }
  
  #shopify-section-{{ section.id }} .btn {
    width: 100%;
  }
  
  #shopify-section-{{ section.id }} .cue {
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 32px;
  }
  @media(min-width: 900px) {
    #shopify-section-{{ section.id }} .cue { display: none; }
  }
  
  #shopify-section-{{ section.id }} .note {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    color: var(--paper-3);
    line-height: 1.6;
    padding: 0 18px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede Text",
      "default": "<p>Swipe through the boxes people order most.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Combo Products Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "save_prefix",
      "label": "Savings Badge Prefix",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "save_em_prefix",
      "label": "Savings Text Prefix",
      "default": "Save"
    },
    {
      "type": "text",
      "id": "products_count_suffix",
      "label": "Products Count Suffix",
      "default": "products"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine Print",
      "default": "Inclusive of all taxes · COD available"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Fallback Button Link (if product has no URL)"
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Mobile Swipe Cue",
      "default": "Swipe for more combos"
    },
    {
      "type": "richtext",
      "id": "rail_note",
      "label": "Footer Note",
      "default": "<p>Tapping Shop bundle opens the bundle picker.</p>"
    },
    {
      "type": "text",
      "id": "rail_aria_label",
      "label": "Aria Label for Rail",
      "default": "Best selling combos"
    }
  ],
  "presets": [
    {
      "name": "Combos"
    }
  ]
}
{% endschema %}
