<section class="hero purelane-hero" id="shopify-section-{{ section.id }}">
  <div class="hero-grid">

    {%- if section.blocks.size > 0 -%}
      <div class="badges glass-2" aria-label="Product promises">
        {%- for block in section.blocks -%}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">{{ block.settings.icon_svg }}</span>
            <span>{{ block.settings.label | newline_to_br }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hero-copy">
      {%- assign heading_parts = section.settings.heading | split: section.settings.heading_highlight -%}
      <h1 class="d1 rv in">
        {%- if heading_parts.size > 1 -%}
          {{ heading_parts[0] | newline_to_br }}<span class="lime">{{ section.settings.heading_highlight }}</span>{{ heading_parts[1] | newline_to_br }}
        {%- else -%}
          {{ section.settings.heading | newline_to_br }}
        {%- endif -%}
      </h1>
      
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      
      <div class="lede rv rv-d2">{{ section.settings.lede }}</div>
      
      <div class="hero-cta rv rv-d3">
        {%- if section.settings.cta_1_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.cta_1_link }}">
            {{ section.settings.cta_1_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.cta_2_link }}">{{ section.settings.cta_2_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="badgestrip rv rv-d4">
          {%- for block in section.blocks -%}
            <div class="glass-2" {{ block.shopify_attributes }}>
              {{ block.settings.icon_svg }}
              {{ block.settings.label | strip_newlines }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {%- assign coll = section.settings.collection -%}
        {%- assign prod1 = coll.products[0] -%}
        {%- assign prod2 = coll.products[1] -%}
        {%- assign prod3 = coll.products[2] -%}
        
        {%- if prod1 -%}
          <div class="hslide hs1 on" data-n="1">
            {{ prod1.featured_image | image_url: height: 800 | image_tag: class: 'hp a d1', loading: 'eager' }}
            {%- assign p1_price = prod1.price -%}
            {%- assign p1_compare = prod1.compare_at_price | default: prod1.price -%}
            <div class="glass-2 ptag">
              <span class="lbl">Single bottle</span>
              <span class="val">
                <strong>{{ p1_price | money_without_trailing_zeros }}</strong>
                {%- if p1_compare > p1_price -%}<s>{{ p1_compare | money_without_trailing_zeros }}</s>{%- endif -%}
              </span>
              {%- if p1_compare > p1_price -%}
                <span class="cut">Save {{ p1_compare | minus: p1_price | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        
        {%- if prod1 and prod2 -%}
          <div class="hslide hs2" data-n="2">
            {{ prod2.featured_image | image_url: height: 800 | image_tag: class: 'hp a d1', loading: 'eager' }}
            {{ prod1.featured_image | image_url: height: 800 | image_tag: class: 'hp b d2', loading: 'eager' }}
            
            {%- assign p2_price = p1_price | plus: prod2.price -%}
            {%- assign p2_compare = p1_compare | plus: prod2.compare_at_price | default: prod2.price -%}
            <div class="glass-2 ptag">
              <span class="lbl">Any 2 products</span>
              <span class="val">
                <strong>{{ p2_price | money_without_trailing_zeros }}</strong>
                {%- if p2_compare > p2_price -%}<s>{{ p2_compare | money_without_trailing_zeros }}</s>{%- endif -%}
              </span>
              {%- if p2_compare > p2_price -%}
                <span class="cut">Save {{ p2_compare | minus: p2_price | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        
        {%- if prod1 and prod2 and prod3 -%}
          <div class="hslide hs3" data-n="3">
            {{ prod2.featured_image | image_url: height: 800 | image_tag: class: 'hp a d1', loading: 'eager' }}
            {{ prod3.featured_image | image_url: height: 800 | image_tag: class: 'hp b d2', loading: 'eager' }}
            {{ prod1.featured_image | image_url: height: 800 | image_tag: class: 'hp c d3', loading: 'eager' }}
            
            {%- assign p3_price = p2_price | plus: prod3.price -%}
            {%- assign p3_compare = p2_compare | plus: prod3.compare_at_price | default: prod3.price -%}
            <div class="glass-2 ptag">
              <span class="lbl">Any 3 products</span>
              <span class="val">
                <strong>{{ p3_price | money_without_trailing_zeros }}</strong>
                {%- if p3_compare > p3_price -%}<s>{{ p3_compare | money_without_trailing_zeros }}</s>{%- endif -%}
              </span>
              {%- if p3_compare > p3_price -%}
                <span class="cut">Save {{ p3_compare | minus: p3_price | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
      
      <div class="hdots" id="hdots">
        {%- if prod1 -%}<button type="button" class="on" aria-label="Show 1 product"></button>{%- endif -%}
        {%- if prod2 -%}<button type="button" aria-label="Show 2 products"></button>{%- endif -%}
        {%- if prod3 -%}<button type="button" aria-label="Show 3 products"></button>{%- endif -%}
      </div>
    </div>

  </div>
</section>

{% style %}
  .purelane-hero {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 150px 0 var(--sec-y);
    background: linear-gradient(178deg, #1ea38d 0%, #0b8578 22%, #017069 48%, #4b3a8f 74%, #01524e 100%);
  }
  .purelane-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(102deg, rgba(1,45,42,.68) 0%, rgba(1,45,42,.40) 30%, rgba(1,45,42,.10) 52%, transparent 66%);
  }
  @media(max-width: 900px) {
    .purelane-hero::before {
      background: linear-gradient(180deg, rgba(1,45,42,.44) 0%, rgba(1,45,42,.22) 34%, rgba(1,40,38,.60) 100%);
    }
  }
  
  .purelane-hero .hero-grid {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
    width: 100%;
    position: relative;
    z-index: 2;
  }
  
  .purelane-hero .hero-copy {
    max-width: 600px;
    position: relative;
    z-index: 3;
  }
  .purelane-hero h1 {
    margin-bottom: 20px;
    text-shadow: 0 6px 40px rgba(2,20,19,.55);
  }
  .purelane-hero .rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 20px;
    max-width: 270px;
  }
  .purelane-hero .rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, rgba(236,230,247,.44), transparent);
  }
  .purelane-hero .rule svg {
    width: 16px;
    height: 16px;
    color: var(--accent);
    flex: 0 0 auto;
  }
  .purelane-hero .hero-cta {
    display: flex;
    gap: 11px;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  
  /* PRODUCT CAROUSEL */
  .purelane-hero .hero-prod {
    position: absolute;
    right: 2%;
    bottom: 28px;
    width: min(50vw, 560px);
    z-index: 2;
    filter: drop-shadow(0 34px 54px rgba(2,20,19,.6));
  }
  @media(max-width: 1200px) {
    .purelane-hero .hero-copy { max-width: 470px; }
    .purelane-hero .hero-prod { width: min(44vw, 440px); right: 3%; }
  }
  @media(max-width: 900px) {
    .purelane-hero { align-items: flex-end; padding-top: 132px; }
    .purelane-hero .hero-copy { max-width: none; }
    .purelane-hero .hero-prod { position: relative; right: auto; bottom: auto; width: min(88vw, 420px); margin: 20px auto 0; }
  }
  
  /* BADGES */
  .purelane-hero .badges {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 96px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 8px;
    border-radius: 20px;
  }
  .purelane-hero .badge {
    text-align: center;
    padding: 11px 4px;
  }
  .purelane-hero .badge + .badge {
    border-top: 1px solid rgba(236,230,247,.14);
  }
  .purelane-hero .badge .bi {
    width: 38px;
    height: 38px;
    margin: 0 auto 8px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(236,230,247,.10);
    border: 1px solid rgba(236,230,247,.22);
    color: var(--accent);
  }
  .purelane-hero .badge .bi svg {
    width: 19px;
    height: 19px;
  }
  .purelane-hero .badge span {
    display: block;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--paper-2);
    line-height: 1.34;
  }
  @media(max-width: 900px) {
    .purelane-hero .badges { display: none; }
  }
  
  /* MOBILE BADGES */
  .purelane-hero .badgestrip {
    display: flex;
    gap: 8px;
    margin-top: 24px;
  }
  .purelane-hero .badgestrip div {
    flex: 1;
    text-align: center;
    padding: 11px 6px;
    border-radius: 14px;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--paper-2);
    line-height: 1.3;
  }
  .purelane-hero .badgestrip svg {
    width: 18px;
    height: 18px;
    margin: 0 auto 6px;
    color: var(--accent);
  }
  @media(min-width: 901px) {
    .purelane-hero .badgestrip { display: none; }
  }
  
  /* STAGE AND SLIDES */
  .purelane-hero .hstage {
    position: relative;
    width: 100%;
    height: clamp(380px, 74svh, 680px);
  }
  .purelane-hero .hslide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding-right: 2%;
    opacity: 0;
    pointer-events: none;
    transition: opacity .85s var(--ease);
  }
  .purelane-hero .hslide.on {
    opacity: 1;
  }
  
  .purelane-hero .hp {
    position: relative;
    width: auto;
    object-fit: contain;
    flex: 0 0 auto;
    opacity: 0;
    transform: translateY(28px) scale(.94);
    transition: opacity .8s var(--ease), transform .8s var(--ease);
    filter: drop-shadow(0 26px 40px rgba(1,22,20,.66));
  }
  .purelane-hero .hslide.on .hp {
    opacity: 1;
    transform: none;
  }
  .purelane-hero .hslide.on .hp.d1 { transition-delay: .06s; }
  .purelane-hero .hslide.on .hp.d2 { transition-delay: .30s; }
  .purelane-hero .hslide.on .hp.d3 { transition-delay: .54s; }
  
  /* Z-INDEX AND SIZING (using real images) */
  .purelane-hero .hs1 .a { height: 100%; z-index: 3; }
  .purelane-hero .hs2 .a { height: 80%; margin-right: -8%; z-index: 1; }
  .purelane-hero .hs2 .b { height: 97%; z-index: 3; }
  .purelane-hero .hs3 .a { height: 75%; margin-right: -8%; z-index: 1; order: 1; }
  .purelane-hero .hs3 .c { height: 97%; z-index: 3; order: 2; }
  .purelane-hero .hs3 .b { height: 79%; margin-left: -8%; z-index: 2; order: 3; }
  
  /* PRICE TAG */
  .purelane-hero .ptag {
    position: absolute;
    left: 0;
    bottom: 2%;
    z-index: 6;
    padding: 11px 14px 12px;
    border-radius: 16px;
    max-width: 52%;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .8s var(--ease) .62s, transform .8s var(--ease) .62s;
  }
  .purelane-hero .hslide.on .ptag {
    opacity: 1;
    transform: none;
  }
  .purelane-hero .ptag .lbl {
    display: block;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .17em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .purelane-hero .ptag .val {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-top: 5px;
  }
  .purelane-hero .ptag .val strong {
    font-family: 'Outfit', sans-serif;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--surface);
    line-height: 1;
  }
  .purelane-hero .ptag .val s {
    font-size: 12px;
    color: var(--paper-3);
  }
  .purelane-hero .ptag .cut {
    display: inline-block;
    margin-top: 7px;
    font-size: 8.4px;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(240,160,60,.20);
    border: 1px solid rgba(240,160,60,.38);
    color: var(--accent);
  }
  
  .purelane-hero .hdots {
    display: flex;
    gap: 7px;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
  }
  .purelane-hero .hdots button {
    width: 6px;
    height: 6px;
    padding: 0;
    border-radius: 50%;
    background: rgba(236,230,247,.28);
    transition: .4s var(--ease);
  }
  .purelane-hero .hdots button.on {
    background: var(--accent);
    width: 20px;
    border-radius: 999px;
  }
  .purelane-hero .hdots button:hover {
    background: rgba(236,230,247,.5);
  }
  
  @media(max-width: 900px) {
    .purelane-hero .hstage { height: clamp(300px, 44svh, 430px); }
    .purelane-hero .ptag { padding: 9px 12px 10px; border-radius: 14px; max-width: 58%; }
    .purelane-hero .ptag .val strong { font-size: 20px; }
  }
{% endstyle %}

<script>
  (function() {
    var hstage = document.getElementById('hstage');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (hstage) {
      var hs = [].slice.call(hstage.querySelectorAll('.hslide'));
      var hd = [].slice.call(document.querySelectorAll('#hdots button'));
      if(hs.length === 0) return;
      
      var hi = 0, htimer = null;
      function hgo(n) {
        hi = (n + hs.length) % hs.length;
        hs.forEach(function (s, i) { s.classList.toggle('on', i === hi); });
        hd.forEach(function (d, i) { d.classList.toggle('on', i === hi); });
      }
      function hplay() { 
        if (!htimer && !reduce && hs.length > 1) {
          htimer = setInterval(function () { hgo(hi + 1); }, 3800); 
        }
      }
      function hstop() { 
        if (htimer) { clearInterval(htimer); htimer = null; } 
      }
      
      hd.forEach(function (d, i) {
        d.addEventListener('click', function () { hstop(); hgo(i); hplay(); });
      });
      hstage.addEventListener('mouseenter', hstop);
      hstage.addEventListener('mouseleave', hplay);
      
      if ('IntersectionObserver' in window && !reduce) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.isIntersecting ? hplay() : hstop(); });
        }, { threshold: 0.2 }).observe(hstage);
      } else { 
        hplay(); 
      }
    }
  })();
</script>

