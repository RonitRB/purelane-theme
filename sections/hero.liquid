<section class="hero purelane-hero theme-dark" id="shopify-section-{{ section.id }}">
  
  <div class="hero-prod" id="heroProd">
    <div class="hstage" id="hstage">
      {%- assign coll = section.settings.collection -%}
      {%- assign prod1 = coll.products[0] -%}
      {%- assign prod2 = coll.products[1] -%}
      {%- assign prod3 = coll.products[2] -%}
      
      {%- assign p1_price = 45000 -%}
      {%- assign p1_compare = 50000 -%}
      {%- if prod1 -%}
        {%- assign p1_price = prod1.price -%}
        {%- assign p1_compare = prod1.compare_at_price | default: prod1.price -%}
      {%- endif -%}

      <div class="hslide hs1 on" data-n="1">
        {%- if prod1 and prod1.featured_image -%}
          {{ prod1.featured_image | image_url: height: 1200 | image_tag: class: 'hp a d1', loading: 'eager' }}
        {%- else -%}
          <div class="elegant-fallback hp a d1"><span>{{ prod1.title | default: 'Purelane' | truncatewords: 2, '' }}</span></div>
        {%- endif -%}
        <div class="ptag">
          <div>
            <span class="lbl">Single bottle</span>
            <span class="val">
              <strong>{{ p1_price | money_without_trailing_zeros }}</strong>
              {%- if p1_compare > p1_price -%}<s>{{ p1_compare | money_without_trailing_zeros }}</s>{%- endif -%}
            </span>
          </div>
          {%- if p1_compare > p1_price -%}
            <span class="cut">Save {{ p1_compare | minus: p1_price | money_without_trailing_zeros }}</span>
          {%- endif -%}
        </div>
      </div>
      
      {%- assign p2_price = 85000 -%}
      {%- assign p2_compare = 100000 -%}
      {%- if prod1 and prod2 -%}
        {%- assign p2_price = p1_price | plus: prod2.price -%}
        {%- assign p2_compare_item = prod2.compare_at_price | default: prod2.price -%}
        {%- assign p2_compare = p1_compare | plus: p2_compare_item -%}
      {%- endif -%}

      <div class="hslide hs2" data-n="2">
        {%- if prod2 and prod2.featured_image -%}
          {{ prod2.featured_image | image_url: height: 1200 | image_tag: class: 'hp a d1', loading: 'eager' }}
        {%- else -%}
          <div class="elegant-fallback hp a d1"><span>{{ prod2.title | default: 'Refill' | truncatewords: 2, '' }}</span></div>
        {%- endif -%}
        {%- if prod1 and prod1.featured_image -%}
          {{ prod1.featured_image | image_url: height: 1200 | image_tag: class: 'hp b d2', loading: 'eager' }}
        {%- else -%}
          <div class="elegant-fallback hp b d2"><span>{{ prod1.title | default: 'Bottle' | truncatewords: 2, '' }}</span></div>
        {%- endif -%}
        
        <div class="ptag">
          <div>
            <span class="lbl">Any 2 products</span>
            <span class="val">
              <strong>{{ p2_price | money_without_trailing_zeros }}</strong>
              {%- if p2_compare > p2_price -%}<s>{{ p2_compare | money_without_trailing_zeros }}</s>{%- endif -%}
            </span>
          </div>
          {%- if p2_compare > p2_price -%}
            <span class="cut">Save {{ p2_compare | minus: p2_price | money_without_trailing_zeros }}</span>
          {%- endif -%}
        </div>
      </div>
      
      {%- assign p3_price = 120000 -%}
      {%- assign p3_compare = 150000 -%}
      {%- if prod1 and prod2 and prod3 -%}
        {%- assign p3_price = p2_price | plus: prod3.price -%}
        {%- assign p3_compare_item = prod3.compare_at_price | default: prod3.price -%}
        {%- assign p3_compare = p2_compare | plus: p3_compare_item -%}
      {%- endif -%}

      <div class="hslide hs3" data-n="3">
        {%- if prod2 and prod2.featured_image -%}
          {{ prod2.featured_image | image_url: height: 1200 | image_tag: class: 'hp a d1', loading: 'eager' }}
        {%- else -%}
          <div class="elegant-fallback hp a d1"><span>{{ prod2.title | default: 'Refill' | truncatewords: 2, '' }}</span></div>
        {%- endif -%}
        {%- if prod3 and prod3.featured_image -%}
          {{ prod3.featured_image | image_url: height: 1200 | image_tag: class: 'hp b d2', loading: 'eager' }}
        {%- else -%}
          <div class="elegant-fallback hp b d2"><span>{{ prod3.title | default: 'Cloth' | truncatewords: 2, '' }}</span></div>
        {%- endif -%}
        {%- if prod1 and prod1.featured_image -%}
          {{ prod1.featured_image | image_url: height: 1200 | image_tag: class: 'hp c d3', loading: 'eager' }}
        {%- else -%}
          <div class="elegant-fallback hp c d3"><span>{{ prod1.title | default: 'Bottle' | truncatewords: 2, '' }}</span></div>
        {%- endif -%}
        
        <div class="ptag">
          <div>
            <span class="lbl">Any 3 products</span>
            <span class="val">
              <strong>{{ p3_price | money_without_trailing_zeros }}</strong>
              {%- if p3_compare > p3_price -%}<s>{{ p3_compare | money_without_trailing_zeros }}</s>{%- endif -%}
            </span>
          </div>
          {%- if p3_compare > p3_price -%}
            <span class="cut">Save {{ p3_compare | minus: p3_price | money_without_trailing_zeros }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  
  <div class="hdots" id="hdots">
    <button type="button" class="on" aria-label="Show 1 product"></button>
    <button type="button" aria-label="Show 2 products"></button>
    <button type="button" aria-label="Show 3 products"></button>
  </div>

  <div class="hero-grid">
    <div class="hero-copy">
      {%- assign heading_parts = section.settings.heading | split: section.settings.heading_highlight -%}
      <h1 class="rv in">
        {%- if heading_parts.size > 1 -%}
          {{ heading_parts[0] | newline_to_br }}<span class="lime">{{ section.settings.heading_highlight }}</span>{{ heading_parts[1] | newline_to_br }}
        {%- else -%}
          {{ section.settings.heading | newline_to_br }}
        {%- endif -%}
      </h1>
      
      <div class="lede rv rv-d1">{{ section.settings.lede }}</div>
      
      <div class="hero-cta rv rv-d2">
        {%- if section.settings.cta_1_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.cta_1_link }}">
            {{ section.settings.cta_1_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.cta_2_link }}">{{ section.settings.cta_2_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="badgestrip rv rv-d3">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {{ block.settings.icon_svg }}
              {{ block.settings.label | strip_newlines }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <div class="badges" aria-label="Product promises">
        {%- for block in section.blocks -%}
          <div class="badge rv rv-d3" {{ block.shopify_attributes }}>
            <span class="bi">{{ block.settings.icon_svg }}</span>
            <span>{{ block.settings.label | strip_newlines }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .purelane-hero {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 0;
    background: var(--ink);
    overflow: hidden;
  }
  
  /* PRODUCT CAROUSEL as Cinematic Background */
  .purelane-hero .hero-prod {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  
  /* Soft Spotlight Bloom */
  .purelane-hero .hero-prod::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 15%;
    transform: translateY(-50%);
    width: 60vh;
    height: 60vh;
    background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }
  
  /* STAGE AND SLIDES */
  .purelane-hero .hstage {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .purelane-hero .hslide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end; /* Align products to right */
    padding-right: 5%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .purelane-hero .hslide.on {
    opacity: 1;
  }
  
  .purelane-hero .hp {
    position: relative;
    width: auto;
    object-fit: contain;
    flex: 0 0 auto;
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    transition: opacity 1.2s var(--ease), transform 1.2s var(--ease);
    filter: drop-shadow(0 34px 54px rgba(18,12,34,.6));
  }
  .purelane-hero .hslide.on .hp {
    opacity: 1;
    transform: scale(1.2); /* Massive scale for premium feel */
  }
  @media(min-width: 900px) {
    .purelane-hero .hslide.on .hp { transform: scale(1.5) translateX(-10%); }
  }
  .purelane-hero .hslide.on .hp.d1 { transition-delay: 0.1s; }
  .purelane-hero .hslide.on .hp.d2 { transition-delay: 0.3s; }
  .purelane-hero .hslide.on .hp.d3 { transition-delay: 0.5s; }
  
  /* Z-INDEX AND SIZING (using real images) */
  .purelane-hero .hs1 .a { height: 75%; z-index: 3; }
  .purelane-hero .hs2 .a { height: 60%; margin-right: -4%; z-index: 1; }
  .purelane-hero .hs2 .b { height: 75%; z-index: 3; }
  .purelane-hero .hs3 .a { height: 55%; margin-right: -4%; z-index: 1; order: 1; }
  .purelane-hero .hs3 .c { height: 75%; z-index: 3; order: 2; }
  .purelane-hero .hs3 .b { height: 60%; margin-left: -4%; z-index: 2; order: 3; }
  
  /* PRICE TAG PILL */
  .purelane-hero .ptag {
    position: relative;
    z-index: 10;
    margin-left: 32px;
    padding: 12px 24px;
    border-radius: 999px; /* Rounded pill like Aurai */
    opacity: 0;
    transition: opacity 0.8s var(--ease) 0.6s, transform 0.8s var(--ease) 0.6s;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: flex;
    align-items: center;
    gap: 16px;
    pointer-events: auto;
    transform: translateX(20px);
  }
  .purelane-hero .hslide.on .ptag {
    opacity: 1;
    transform: translateX(0);
  }
  .purelane-hero .ptag .lbl {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }
  .purelane-hero .ptag .val {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .purelane-hero .ptag .val strong {
    font-size: 18px;
    font-weight: 600;
    color: var(--surface);
  }
  .purelane-hero .ptag .val s {
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    text-decoration: line-through;
  }
  .purelane-hero .ptag .cut {
    display: none;
  }
  
  /* HERO COPY LAYER (Bottom Aligned) */
  .purelane-hero .hero-grid {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 24px;
    width: 100%;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none; /* Let touches pass through where empty */
    padding-bottom: 48px;
  }
  @media(min-width: 900px) {
    .purelane-hero .hero-grid {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding-bottom: 64px;
    }
  }
  
  .purelane-hero .hero-copy {
    position: relative;
    z-index: 10;
    pointer-events: auto;
    max-width: 600px;
  }
  .purelane-hero h1 {
    font-size: clamp(48px, 8vw, 100px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 300;
    margin-bottom: 24px;
    color: var(--surface);
  }
  .purelane-hero .lime { color: var(--accent); font-weight: 400; }
  
  .purelane-hero .lede {
    font-size: clamp(16px, 1.5vw, 20px);
    color: rgba(255,255,255,0.7);
    max-width: 520px;
    line-height: 1.6;
    margin-bottom: 40px;
    font-weight: 400;
  }
  
  .purelane-hero .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  /* DOTS */
  .purelane-hero .hdots {
    display: flex;
    gap: 8px;
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    pointer-events: auto;
  }
  .purelane-hero .hdots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: none;
    transition: 0.4s var(--ease);
    cursor: pointer;
  }
  .purelane-hero .hdots button.on {
    background: var(--surface);
    width: 24px;
    border-radius: 999px;
  }
  .purelane-hero .hdots button:hover {
    background: rgba(255,255,255,0.5);
  }
  
  /* BADGES (Now floating right on desktop) */
  .purelane-hero .badges {
    display: none;
  }
  @media(min-width: 900px) {
    .purelane-hero .badges {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 12px;
      pointer-events: auto;
    }
    .purelane-hero .badge {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(16px);
      padding: 10px 20px;
      border-radius: 999px; /* Aurai pill style */
      color: var(--surface);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
    }
    .purelane-hero .badge .bi {
      width: 20px;
      height: 20px;
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .purelane-hero .badge .bi svg {
      width: 100%;
      height: 100%;
    }
    .purelane-hero .badge span:not(.bi) {
      white-space: nowrap;
    }
  }
  
  /* MOBILE BADGES (Pills at bottom) */
  .purelane-hero .badgestrip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    pointer-events: auto;
  }
  .purelane-hero .badgestrip div {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    color: var(--surface);
    white-space: nowrap;
  }
  .purelane-hero .badgestrip svg {
    width: 14px;
    height: 14px;
    color: var(--accent);
  }
  @media(min-width: 901px) {
    .purelane-hero .badgestrip { display: none; }
  }
  
  @media(max-width: 900px) {
    .purelane-hero { min-height: 100svh; }
    .purelane-hero .hslide { padding-right: 0; justify-content: center; align-items: center; padding-bottom: 20vh; }
    .purelane-hero .hslide.on .hp { transform: scale(1.1); }
    .purelane-hero .ptag { right: auto; left: 50%; top: 60%; transform: translateX(-50%); }
    .purelane-hero .hslide.on .ptag { transform: translateX(-50%) translateY(0); }
  }
{% endstyle %}

<script>
  function initHeroCarousel() {
    var hstage = document.getElementById('hstage');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (hstage && !hstage.dataset.initialized) {
      hstage.dataset.initialized = 'true';
      var hs = [].slice.call(hstage.querySelectorAll('.hslide'));
      var hd = [].slice.call(document.querySelectorAll('#hdots button'));
      if(hs.length === 0) return;
      
      var hi = 0, htimer = null;
      function hgo(n) {
        hi = (n + hs.length) % hs.length;
        hs.forEach(function (s, i) { s.classList.toggle('on', i === hi); });
        hd.forEach(function (d, i) { d.classList.toggle('on', i === hi); });
      }
      function hplay() { 
        if (!htimer && !reduce && hs.length > 1) {
          htimer = setInterval(function () { hgo(hi + 1); }, 3800); 
        }
      }
      function hstop() { 
        if (htimer) { clearInterval(htimer); htimer = null; } 
      }
      
      hd.forEach(function (d, i) {
        d.addEventListener('click', function () { hstop(); hgo(i); hplay(); });
      });
      hstage.addEventListener('mouseenter', hstop);
      hstage.addEventListener('mouseleave', hplay);
      
      if ('IntersectionObserver' in window && !reduce) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.isIntersecting ? hplay() : hstop(); });
        }, { threshold: 0.2 }).observe(hstage);
      } else { 
        hplay(); 
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initHeroCarousel);
  document.addEventListener('shopify:section:load', initHeroCarousel);
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean\nThat\nLasts"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight Word",
      "default": "Lasts"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede Text",
      "default": "<p>Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.</p>"
    },
    {
      "type": "text",
      "id": "cta_1_label",
      "label": "Primary CTA Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_1_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "cta_2_label",
      "label": "Secondary CTA Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "cta_2_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "collection",
