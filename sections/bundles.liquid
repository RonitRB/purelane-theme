<section class="sec bundles-sec" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    <div class="cats">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <a class="glass cat rv rv-d{{ forloop.index | modulo: 4 }}" href="{{ collection.url | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="ph">
              {%- assign img = collection.image | default: collection.products.first.featured_image -%}
              {%- if img -%}
                {{ img | image_url: height: 360 | image_tag: class: 'pimg', loading: 'lazy' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'pimg placeholder' }}
              {%- endif -%}
            </span>
            <span class="txt">
              <h4>{{ collection.title | default: block.settings.title | default: 'Bundle Title' }}</h4>
              <p>{{ collection.description | strip_html | truncatewords: 10 | default: block.settings.subtitle | default: 'Bundle description goes here' }}</p>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <a class="glass cat rv rv-d{{ forloop.index | modulo: 4 }}" href="#">
            <span class="ph">
              {{ 'collection-' | append: i | placeholder_svg_tag: 'pimg placeholder' }}
            </span>
            <span class="txt">
              <h4>Example Bundle</h4>
              <p>Description of the bundle</p>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .bundles-sec {
    position: relative;
    padding: var(--sec-y) 0;
  }
  #shopify-section-{{ section.id }} .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }
  #shopify-section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 26px;
  }
  #shopify-section-{{ section.id }} .panel-head .kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  #shopify-section-{{ section.id }} .panel-head .d2 {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .cats {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media(min-width: 900px) {
    #shopify-section-{{ section.id }} .cats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  #shopify-section-{{ section.id }} .cat {
    padding: 0;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform .4s var(--ease);
  }
  #shopify-section-{{ section.id }} .cat:hover {
    transform: translateY(-5px);
  }
  @media(prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .cat:hover {
      transform: none;
    }
  }
  
  #shopify-section-{{ section.id }} .cat .ph {
    height: 194px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 14px 12px 0;
    position: relative;
  }
  #shopify-section-{{ section.id }} .cat .ph::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(110% 80% at 50% 6%, rgba(236,230,247,.20), rgba(75,58,143,.10) 56%, transparent 78%);
  }
  #shopify-section-{{ section.id }} .cat .ph .pimg {
    position: relative;
    max-height: 176px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 16px 24px rgba(1,24,22,.58));
  }
  #shopify-section-{{ section.id }} .cat .ph .placeholder {
    width: 100%;
    height: 100%;
    fill: var(--g-line);
    filter: none;
  }
  
  #shopify-section-{{ section.id }} .cat .txt {
    padding: 14px 16px 18px;
    border-top: 1px solid rgba(236,230,247,.12);
  }
  #shopify-section-{{ section.id }} .cat .txt h4 {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: var(--surface);
    margin-bottom: 5px;
  }
  #shopify-section-{{ section.id }} .cat .txt p {
    font-size: 11.8px;
    color: var(--paper-3);
    margin: 0;
  }

  @media(max-width: 760px) {
    #shopify-section-{{ section.id }} .cat .ph { height: 158px; }
    #shopify-section-{{ section.id }} .cat .ph .pimg { max-height: 142px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Bundle Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override Title (Optional)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Override Subtitle (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Kitchen bundle",
            "subtitle": "Grease, dishes & more"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Bathroom bundle",
            "subtitle": "Deep clean & disinfect"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Laundry bundle",
            "subtitle": "Softer, fresher wash"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Hard water bundle",
            "subtitle": "Melt away limescale"
          }
        }
      ]
    }
  ]
}
{% endschema %}
