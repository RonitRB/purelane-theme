            "cta_label": "Shop Starter",
            "highlight": false
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Most Popular",
            "subtitle": "Everything you need",
            "price": "₹1,499",
            "compare_at": "₹1,899",
            "features": "4 core cleaners\n2 microfibre cloths\nFree express shipping\nRefill discount",
            "cta_label": "Shop Most Popular",
            "highlight": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Whole Home",
            "subtitle": "The complete set",
            "price": "₹2,499",
