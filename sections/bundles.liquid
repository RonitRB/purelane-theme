<section class="sec bundles-sec" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </div>
    
    <div class="tiers-grid">
      {%- for block in section.blocks -%}
        {%- assign is_highlighted = block.settings.highlight -%}
        {%- assign card_class = 'glass tier-card rv rv-d' | append: forloop.index -%}
        {%- if is_highlighted -%}
          {%- assign card_class = card_class | append: ' highlight' -%}
        {%- endif -%}

        <div class="{{ card_class }}" {{ block.shopify_attributes }}>
          {%- if is_highlighted and section.settings.highlight_badge != blank -%}
            <div class="tier-badge">{{ section.settings.highlight_badge | escape }}</div>
          {%- endif -%}
          
          <div class="tier-head">
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>

          <div class="tier-price">
            <strong>{{ block.settings.price | escape }}</strong>
            {%- if block.settings.compare_at != blank -%}
              <s>{{ block.settings.compare_at | escape }}</s>
            {%- endif -%}
          </div>
          
          <div class="tier-body">
            {%- if block.settings.features != blank -%}
              <ul class="features">
                {%- assign features_list = block.settings.features | newline_to_br | split: '<br />' -%}
                {%- for feature in features_list -%}
                  {%- assign f = feature | strip -%}
                  {%- if f != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                      {{ f | escape }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            
            {%- if block.settings.products != blank -%}
              <div class="includes">
                <span class="inc-title">Includes:</span>
                <ul>
                  {%- for prod in block.settings.products -%}
                    <li>{{ prod.title | escape }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
          
          <div class="tier-foot">
            {%- assign btn_class = 'btn btn-ghost' -%}
            {%- if is_highlighted -%}
              {%- assign btn_class = 'btn btn-primary' -%}
            {%- endif -%}
            <a href="{{ block.settings.cta_link | default: '#' }}" class="{{ btn_class }}">
              {{ block.settings.cta_label | default: 'Choose Plan' | escape }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .bundles-sec {
    position: relative;
    padding: var(--sec-y) 0;
  }
  #shopify-section-{{ section.id }} .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }
  #shopify-section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .panel-head .kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  #shopify-section-{{ section.id }} .panel-head .d2 {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .tiers-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media(min-width: 860px) {
    #shopify-section-{{ section.id }} .tiers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .tier-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 16px;
    position: relative;
    background: linear-gradient(162deg, rgba(236,230,247,.08), rgba(75,58,143,.04));
    transition: transform .4s var(--ease);
  }
  #shopify-section-{{ section.id }} .tier-card.highlight {
    background: linear-gradient(162deg, rgba(236,230,247,.14), rgba(75,58,143,.12));
    border-color: rgba(240,160,60,.3);
    box-shadow: 0 24px 48px rgba(18,12,34,.3), 0 0 0 1px rgba(240,160,60,.1) inset;
    padding: 32px 24px;
    z-index: 2;
  }

  @media(prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .tier-card:hover {
      transform: translateY(-5px);
    }
  }

  #shopify-section-{{ section.id }} .tier-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #120c22;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .tier-head {
    text-align: center;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(236,230,247,.1);
  }
  #shopify-section-{{ section.id }} .tier-head h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 22px;
    color: var(--surface);
    margin-bottom: 6px;
  }
  #shopify-section-{{ section.id }} .tier-head .subtitle {
    font-size: 13px;
    color: var(--paper-2);
  }

  #shopify-section-{{ section.id }} .tier-price {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .tier-price strong {
    font-family: 'Outfit', sans-serif;
    font-size: 32px;
    color: var(--surface);
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .tier-price s {
    font-size: 14px;
    color: var(--paper-3);
  }

  #shopify-section-{{ section.id }} .tier-body {
    flex-grow: 1;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
  }
  #shopify-section-{{ section.id }} .features li {
    font-size: 14px;
    color: var(--paper-2);
    margin-bottom: 12px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .features li svg {
    width: 16px;
    height: 16px;
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  #shopify-section-{{ section.id }} .includes {
    padding-top: 20px;
    border-top: 1px solid rgba(236,230,247,.1);
  }
  #shopify-section-{{ section.id }} .inc-title {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--paper-3);
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .includes ul {
    list-style: disc;
    padding-left: 18px;
    margin: 0;
    font-size: 13px;
    color: var(--paper-2);
  }
  #shopify-section-{{ section.id }} .includes ul li {
    margin-bottom: 4px;
  }

  #shopify-section-{{ section.id }} .tier-foot .btn {
    width: 100%;
    justify-content: center;
  }
{% endstyle %}

