<section class="sec theme-dark bundles-sec" id="shopify-section-{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </div>
    
    <div class="tiers-grid">
      {%- for block in section.blocks -%}
        {%- assign is_highlighted = block.settings.highlight -%}
        {%- assign card_class = 'glass tier' -%}
        {%- if is_highlighted -%}
          {%- assign card_class = card_class | append: ' best' -%}
        {%- endif -%}

        <div class="{{ card_class }}" {{ block.shopify_attributes }}>
          {%- if is_highlighted and section.settings.highlight_badge != blank -%}
            <div class="tier-badge">{{ section.settings.highlight_badge | escape }}</div>
          {%- endif -%}
          
          <div class="tier-head">
            <h3 class="d4">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="body-s">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>

          <div class="tier-price">
            <strong>{{ block.settings.price | escape }}</strong>
            {%- if block.settings.compare_at != blank -%}
              <s>{{ block.settings.compare_at | escape }}</s>
            {%- endif -%}
          </div>
          
          <div class="tier-body">
            {%- if block.settings.features != blank -%}
              <ul class="features">
                {%- assign features_list = block.settings.features | newline_to_br | split: '<br />' -%}
                {%- for feature in features_list -%}
                  {%- assign f = feature | strip -%}
                  {%- if f != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                      {{ f | escape }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
          
          <div class="tier-foot">
            {%- assign btn_class = 'btn btn-ghost' -%}
            {%- if is_highlighted -%}
              {%- assign btn_class = 'btn btn-primary' -%}
            {%- endif -%}
            <a href="{{ block.settings.cta_link | default: '#' }}" class="{{ btn_class }}">
              {{ block.settings.cta_label | default: 'Choose Plan' | escape }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .bundles-sec {
    position: relative;
    padding: var(--sec-y) 0;
  }
  #shopify-section-{{ section.id }} .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }
  #shopify-section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .panel-head .kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  #shopify-section-{{ section.id }} .panel-head .d2 {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .tiers-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  @media(min-width: 760px) {
    #shopify-section-{{ section.id }} .tiers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .tier {
    flex: 1;
    min-width: 280px;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    text-align: center;
    border-radius: var(--r);
    border: 1px solid rgba(255,255,255,0.06);
    transition: transform .4s var(--ease), border-color .4s var(--ease);
  }
  #shopify-section-{{ section.id }} .tier:hover {
    transform: translateY(-6px);
    border-color: rgba(236,230,247,.3);
  }
  #shopify-section-{{ section.id }} .tier.best {
    border-color: rgba(240,160,60,.44);
    box-shadow: 0 26px 74px rgba(18,12,34,.44), 0 0 0 1px rgba(240,160,60,.2), var(--g-inset);
  }

  #shopify-section-{{ section.id }} .tier-badge {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    margin-bottom: 14px;
    background: rgba(240,160,60,.18);
    border: 1px solid rgba(240,160,60,.34);
    color: var(--accent);
  }

  @media(min-width: 760px) {
    #shopify-section-{{ section.id }} .tier.best {
      transform: scale(1.05);
      z-index: 2;
    }
    #shopify-section-{{ section.id }} .tier.best:hover {
      transform: scale(1.08);
    }
  }

  #shopify-section-{{ section.id }} .tier-head h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--surface);
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }
  
  #shopify-section-{{ section.id }} .tier-head p {
    font-size: 14px;
    color: rgba(236,230,247,0.5);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tier-price {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 27px;
    color: var(--accent);
    margin: 16px 0 4px;
  }
  #shopify-section-{{ section.id }} .tier-price s {
    font-size: 14px;
    color: var(--paper-3);
    font-weight: 500;
    margin-left: 8px;
  }
  #shopify-section-{{ section.id }} .tier-price strong {
    font-weight: inherit;
    font-size: inherit;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .features {
    list-style: none;
    margin: 16px 0 20px;
    display: grid;
    gap: 8px;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .features li {
    display: flex;
    gap: 9px;
    font-size: 13px;
    color: var(--text-sub);
  }
  #shopify-section-{{ section.id }} .features li svg {
    width: 14px;
    height: 14px;
    color: var(--accent);
    flex: 0 0 auto;
    margin-top: 4px;
  }
  
  #shopify-section-{{ section.id }} .tier-foot .btn {
    width: 100%;
    justify-content: center;
    height: 56px;
    font-size: 16px;
  }
{% endstyle %}

{% schema %}
