{%- comment -%}
  Accepts:
  - product: {Object} Product Liquid object
  - badge_override: {String} Optional badge label to use instead of product metafield
  - loading: {String} Optional. 'eager' or 'lazy'. Default is 'lazy'.

  Usage:
  {% render 'product-card', product: product %}
{%- endcomment -%}

{%- liquid
  assign loading = loading | default: 'lazy'
  assign badge_label = badge_override
  if product != blank and badge_label == blank and product.metafields.custom.badge_label != blank
    assign badge_label = product.metafields.custom.badge_label.value
  endif
  
  if product != blank
    assign variant = product.selected_or_first_available_variant
    assign price = variant.price
    assign compare_at = variant.compare_at_price
    assign is_sold_out = false
    if product.available == false
      assign is_sold_out = true
    endif

    assign has_discount = false
    if compare_at != blank and compare_at > price
      assign has_discount = true
      assign discount_amount = compare_at | minus: price
      assign discount_percent = discount_amount | times: 100.0 | divided_by: compare_at | round
    endif
    assign prod_title = product.title
    assign prod_url = product.url
  else
    assign prod_title = 'Purelane Floor Cleaner'
    assign prod_url = '#'
  endif
-%}

<article class="glass purelane-card" {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    <a href="{{ prod_url }}" class="shot">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 33vw' }}
      {%- else -%}
        <img src="{{ 'fallback-bottle.png' | asset_url }}" alt="Purelane" loading="lazy" class="fallback-img">
      {%- endif -%}
    </a>
    
    <div class="card-info">
      <div class="rate">
        {%- comment -%}Placeholder for rating{%- endcomment -%}
        <b>★ 4.8</b> &middot; 237 reviews
      </div>
      
      <h4 class="card-title">{{ prod_title | escape }}</h4>
      
      <div class="pr">
        <strong>{{ price | money_without_trailing_zeros }}</strong>
        {%- if has_discount -%}
          <s>{{ compare_at | money_without_trailing_zeros }}</s>
          <em class="badge">Save {{ discount_amount | money_without_trailing_zeros }}</em>
        {%- endif -%}
      </div>

      <button type="button" class="btn btn-primary" style="width: 100%;">
        Add to cart
      </button>
    </div>
  {%- else -%}
    <div class="shot">
      <img src="{{ 'fallback-bottle.png' | asset_url }}" alt="Purelane" loading="lazy" class="fallback-img">
    </div>
    
    <div class="card-info">
      <div class="rate">
        <b>★ 4.8</b> &middot; 237 reviews
      </div>
      <h4 class="card-title">Purelane Floor Cleaner</h4>
      <div class="pr">
        <strong>₹499</strong><s>₹599</s>
      </div>
      <button type="button" class="btn btn-primary" style="width: 100%;">
        Add to cart
      </button>
    </div>
  {%- endif -%}
</article>

{% style %}
  .purelane-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    height: 100%;
  }
  
  .purelane-card .shot {
    aspect-ratio: 1 / 1;
    background: #F4F3F0;
    border-bottom: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: var(--r) var(--r) 0 0;
  }
  .purelane-card .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    mix-blend-mode: multiply;
  }
  .purelane-card .shot .fallback-img {
    width: 70%;
    height: 70%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .purelane-card:hover .shot img,
  .purelane-card:hover .shot .fallback-img {
    transform: scale(1.03);
  }

  .purelane-card .card-info {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .purelane-card .rate {
    font-size: 11px;
    color: var(--text-sub);
    margin-bottom: 8px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .purelane-card .rate b {
    color: var(--text-main);
    font-weight: 600;
  }
  
  .purelane-card .card-title {
    font-size: 22px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .purelane-card .pr {
    margin-top: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 24px;
  }
  .purelane-card .pr strong {
    font-size: 20px;
    color: var(--text-main);
    font-weight: 600;
  }
  .purelane-card .pr s {
    font-size: 14px;
    color: var(--text-sub);
    text-decoration: line-through;
    opacity: 0.7;
  }
  .purelane-card .pr .badge {
    margin-left: auto;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--border-color);
    color: var(--text-main);
    font-style: normal;
  }
  
  @media(max-width: 768px) {
    .purelane-card .card-info { padding: 24px 20px; }
  }
{% endstyle %}
