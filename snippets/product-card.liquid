{%- comment -%}
  Accepts:
  - product: {Object} Product Liquid object
  - badge_override: {String} Optional badge label to use instead of product metafield
  - loading: {String} Optional. 'eager' or 'lazy'. Default is 'lazy'.

  Usage:
  {% render 'product-card', product: product %}
{%- endcomment -%}

{%- liquid
  assign loading = loading | default: 'lazy'
  assign badge_label = badge_override
  if product != blank and badge_label == blank and product.metafields.custom.badge_label != blank
    assign badge_label = product.metafields.custom.badge_label.value
  endif
  
  if product != blank
    assign variant = product.selected_or_first_available_variant
    assign price = variant.price
    assign compare_at = variant.compare_at_price
    assign is_sold_out = false
    if product.available == false
      assign is_sold_out = true
    endif

    assign has_discount = false
    if compare_at != blank and compare_at > price
      assign has_discount = true
      assign discount_amount = compare_at | minus: price
      assign discount_percent = discount_amount | times: 100.0 | divided_by: compare_at | round
    endif
    assign prod_title = product.title
    assign prod_url = product.url
  else
    assign prod_title = 'Purelane Floor Cleaner'
    assign prod_url = '#'
  endif
-%}

<article class="glass purelane-card" {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    <a href="{{ prod_url }}" class="shot">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 33vw' }}
      {%- else -%}
        <div class="pimg p-floor" style="width: 100%; height: 100%;"></div>
      {%- endif -%}
    </a>
    
    <div class="card-info">
      <div class="rate">
        {%- comment -%}Placeholder for rating{%- endcomment -%}
        <b>★ 4.8</b> &middot; 237 reviews
      </div>
      
      <h4 class="card-title">{{ prod_title | escape }}</h4>
      
      <div class="pr">
        <strong>{{ price | money_without_trailing_zeros }}</strong>
        {%- if has_discount -%}
          <s>{{ compare_at | money_without_trailing_zeros }}</s>
          <em class="badge">Save {{ discount_amount | money_without_trailing_zeros }}</em>
        {%- endif -%}
      </div>

      <button type="button" class="btn btn-primary" style="width: 100%;">
        Add to cart
      </button>
    </div>
  {%- else -%}
    <div class="shot">
      <div class="pimg p-floor" style="width: 100%; height: 100%;"></div>
    </div>
    
    <div class="card-info">
      <div class="rate">
        <b>★ 4.8</b> &middot; 237 reviews
      </div>
      <h4 class="card-title">Purelane Floor Cleaner</h4>
      <div class="pr">
        <strong>₹499</strong><s>₹599</s>
      </div>
      <button type="button" class="btn btn-primary" style="width: 100%;">
        Add to cart
      </button>
    </div>
  {%- endif -%}
</article>

{% style %}
  .purelane-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    height: 100%;
    transition: transform .4s var(--ease), border-color .4s var(--ease);
  }
  .purelane-card:hover {
    transform: translateY(-6px);
    border-color: rgba(236,230,247,.3);
  }
  
  .purelane-card .shot {
    aspect-ratio: 4 / 5;
    background: linear-gradient(160deg, rgba(236,230,247,.08), rgba(75,58,143,.12));
    border-bottom: 1px solid rgba(236,230,247,.1);
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .purelane-card .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .purelane-card .pimg {
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(0.85);
  }

  .purelane-card .card-info {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .purelane-card .rate {
    font-size: 13px;
    color: var(--paper-2);
    margin-bottom: 8px;
  }
  .purelane-card .rate b {
    color: var(--accent);
    font-weight: 700;
  }
  
  .purelane-card .card-title {
    font-size: 18px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    color: var(--surface);
    line-height: 1.3;
    margin-bottom: 16px;
  }
  
  .purelane-card .pr {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 20px;
  }
  .purelane-card .pr strong {
    font-family: 'Outfit', sans-serif;
    font-size: 24px;
    color: var(--surface);
    font-weight: 800;
  }
  .purelane-card .pr s {
    font-size: 14px;
    color: var(--paper-3);
  }
  .purelane-card .pr .badge {
    margin-left: auto;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(240,160,60,.15);
    color: var(--accent);
    font-style: normal;
  }
  
  @media(max-width: 768px) {
    .purelane-card .card-info { padding: 18px; }
    .purelane-card .card-title { font-size: 16px; }
    .purelane-card .pr strong { font-size: 20px; }
  }
{% endstyle %}
